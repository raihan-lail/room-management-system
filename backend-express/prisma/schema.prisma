generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "library"
  runtime    = "bun"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee?
  resident Resident?
    notifications Notification[]
    auditLogs AuditLog[] @relation("AuditLogActor")

}

model Site {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]
  roles     Role[]
  Locations Location[]
  residents Resident[]
}

model Employee {
  id     String @id @default(cuid())
  userId String @unique
  name   String

  siteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site? @relation(fields: [siteId], references: [id])

  roles       EmployeeRole[]
  permissions EmployeePermission[]

  user User @relation(fields: [userId], references: [id])
}

model Role {
  id          String   @id @default(cuid())
  siteId      String?
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site        Site?            @relation(fields: [siteId], references: [id])
  employees   EmployeeRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles     RolePermission[]
  employees EmployeePermission[]
}

model EmployeeRole {
  employeeId String
  roleId     String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([employeeId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model EmployeePermission {
  employeeId   String
  permissionId String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([employeeId, permissionId])
  @@index([permissionId])
}

model Location {
  id          String   @id @default(cuid())
  siteId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site   Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  floors Floor[]

  @@unique([siteId, name])
  @@index([siteId])
}

model Floor {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  floorNumber Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  rooms    Room[]

  @@unique([locationId, floorNumber])
  @@index([locationId])
}

model Room {
  id          String   @id @default(cuid())
  floorId     String
  name        String
  type        String   @default("Standard")
  description String?
  row         String?
  isBookable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floor Floor @relation(fields: [floorId], references: [id], onDelete: Restrict)
  beds Bed[]
  allocation RoomAllocation?

  @@unique([floorId, name])
  @@index([floorId])
}
enum BedStatus {
  VACANT
  BOOKED
  OCCUPIED
  HOME_LEAVE
}
model Bed {
  id          String   @id @default(cuid())
  roomId      String
  name        String
  description String?
  status      BedStatus   @default(VACANT)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  

  @@unique([roomId, name])
  @@index([roomId])
}

model RoomAllocation {
  id          String   @id @default(cuid())
  roomId      String   @unique
  purpose     String
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([purpose])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Resident {
  id          String   @id @default(cuid())
  userId      String @unique
  siteId      String
  fullName    String
  phone       String
  gender      Gender
  nationality String?
  mealType    String
  company     String?
  department  String?
  title       String?
  status      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site? @relation(fields: [siteId], references: [id])

   user User @relation(fields: [userId], references: [id])

  @@index([siteId])
  @@index([fullName])
  @@index([company])
  @@index([department])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorName   String?
  action      String
  resource    String
  resourceId  String?
  description String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor User? @relation("AuditLogActor",fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
}