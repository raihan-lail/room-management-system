# Docker Compose environment for the VPS deployment.
# Copy to .env on the server and fill in real values. Never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=camp_management

JWT_SECRET=change-me

# Comma-separated extra origins. Leave empty when nginx serves the frontend on
# the same origin as the API.
CORS_ORIGINS=

# Set to false only when the app is served over plain HTTP. Secure cookies are
# not stored by browsers on plain HTTP hosts.
COOKIE_SECURE=false

SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Super Admin

SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Room Management System
SMTP_FROM_EMAIL=
